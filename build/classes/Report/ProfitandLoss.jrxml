<!-- Created with Jaspersoft Studio version 6.20.0.final using JasperReports Library version 6.20.0-2bc7ab61c56f459e8176eb05c7705e145cd400ad  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ProfitandLoss" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="0311b093-5eb4-4a77-be80-1b813cd4cb9b">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ReportShop"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
    COALESCE(SUM(a.TotalBlance), 0) AS TotalBalanceSum, 
    COALESCE(SUM(a.DiscountTk), 0) AS DiscountSum,
    COALESCE(SUM(sr.Amount), 0) AS SaleReturnAmount,
    COALESCE(SUM(a.TotalBlance) - (SUM(a.DiscountTk) + SUM(sr.Amount)), 0) AS NetSale,
    
    -- Total buy cost subquery
    (SELECT COALESCE(SUM(subquery.single_buy_cost), 0) 
     FROM (
         SELECT invaudit.qty, purchase.Rate, invaudit.qty * purchase.Rate AS single_buy_cost 
         FROM invaudit 
         INNER JOIN purchase ON invaudit.Barcode = purchase.Barcode
     ) AS subquery) AS total_buy_cost,
    
    -- Gross profit calculation
    COALESCE(SUM(a.TotalBlance) - (SUM(a.DiscountTk) + SUM(sr.Amount)), 0) 
    - COALESCE((SELECT SUM(subquery.single_buy_cost) 
                FROM ( 
                    SELECT invaudit.qty, purchase.Rate, invaudit.qty * purchase.Rate AS single_buy_cost 
                    FROM invaudit 
                    INNER JOIN purchase ON invaudit.Barcode = purchase.Barcode
                ) AS subquery), 0) AS Gross_profit,
    
    -- Other incomes
    COALESCE(SUM(CASE WHEN ps.Reasone = 'Others (Income)' THEN ps.Amount ELSE 0 END), 0) AS Other_Income,
    COALESCE(SUM(CASE WHEN ps.Reasone = 'Servicing Charge' THEN ps.Amount ELSE 0 END), 0) AS Servicing_Charge,
    COALESCE(SUM(CASE WHEN ps.Reasone = 'Commission' THEN ps.Amount ELSE 0 END), 0) AS Commission,
    COALESCE(SUM(CASE WHEN ps.Reasone IN ('Others (Income)', 'Servicing Charge', 'Commission') THEN ps.Amount ELSE 0 END), 0) AS Other_services_charge,
    
    -- Total gross profit calculation
    COALESCE(SUM(CASE WHEN ps.Reasone IN ('Others (Income)', 'Servicing Charge', 'Commission') THEN ps.Amount ELSE 0 END), 0) 
    + COALESCE(SUM(a.TotalBlance) - (SUM(a.DiscountTk) + SUM(sr.Amount)), 0) 
    - COALESCE((SELECT SUM(subquery.single_buy_cost) 
                FROM ( 
                    SELECT invaudit.qty, purchase.Rate, invaudit.qty * purchase.Rate AS single_buy_cost 
                    FROM invaudit 
                    INNER JOIN purchase ON invaudit.Barcode = purchase.Barcode
                ) AS subquery), 0) AS Total_gross_profit,
                
    -- Expenses
    COALESCE(SUM(CASE WHEN ps.Reasone = 'Monthly Bills' THEN ps.Amount ELSE 0 END), 0) AS Monthly_Bills,
    COALESCE(SUM(CASE WHEN ps.Reasone = 'Entertainment' THEN ps.Amount ELSE 0 END), 0) AS Entertainment,
    COALESCE(SUM(CASE WHEN ps.Reasone = 'Carrying Charge' THEN ps.Amount ELSE 0 END), 0) AS Carrying_charge,
    COALESCE(SUM(CASE WHEN ps.Reasone = 'Other Expense' THEN ps.Amount ELSE 0 END), 0) AS Other_Expense,
    COALESCE(SUM(CASE WHEN ps.Reasone = 'Discount' THEN ps.Amount ELSE 0 END), 0) AS Discount,
    COALESCE(SUM(CASE WHEN ps.Reasone = 'Commission' THEN ps.Amount ELSE 0 END), 0) AS Payment_Commission,
    COALESCE(SUM(CASE WHEN ps.Reasone = 'Yearly Bills' THEN ps.Amount ELSE 0 END), 0) AS Yearly_Bills,
    COALESCE(SUM(CASE WHEN ps.Reasone = 'Salary' THEN ps.Amount ELSE 0 END), 0) AS Salary,
    COALESCE(SUM(CASE WHEN ps.Reasone = 'Bank Interest' THEN ps.Amount ELSE 0 END), 0) AS Bank_Interest,
    COALESCE(SUM(CASE WHEN ps.Reasone = 'Depreciation' THEN ps.Amount ELSE 0 END), 0) AS Depreciation,
    COALESCE(SUM(CASE WHEN ps.Reasone = 'Daily Expenditure' THEN ps.Amount ELSE 0 END), 0) AS Daily_Expenditure,
    COALESCE(SUM(CASE WHEN ps.Reasone = 'Purchasing Extra Expenditure' THEN ps.Amount ELSE 0 END), 0) AS Purchasing_extra_Expenditure,
    COALESCE(SUM(CASE WHEN ps.Reasone IN ('Monthly Bills', 'Entertainment', 'Carrying Charge', 'Other Expense', 'Yearly Bills', 'Commision', 'Discount', 'Purchasing Extra Expenditure', 'Daily Expenditure', 'Depreciation', 'Bank Interest', 'Salary') THEN ps.Amount ELSE 0 END), 0) AS Total_Expense,
    
    -- Net profit or loss calculation
    COALESCE(SUM(a.TotalBlance) - (SUM(a.DiscountTk) + SUM(sr.Amount)), 0) 
    + COALESCE(SUM(CASE WHEN ps.Reasone IN ('Others (Income)', 'Servicing Charge', 'Commission') THEN ps.Amount ELSE 0 END), 0) 
    - COALESCE((SELECT SUM(subquery.single_buy_cost) 
                FROM ( 
                    SELECT invaudit.qty, purchase.Rate, invaudit.qty * purchase.Rate AS single_buy_cost 
                    FROM invaudit 
                    INNER JOIN purchase ON invaudit.Barcode = purchase.Barcode
                ) AS subquery), 0) 
    - COALESCE(SUM(CASE WHEN ps.Reasone IN ('Monthly Bills', 'Entertainment', 'Carrying Charge', 'Other Expense', 'Yearly Bills', 'Commision', 'Discount', 'Purchasing Extra Expenditure', 'Daily Expenditure', 'Depreciation', 'Bank Interest', 'Salary') THEN ps.Amount ELSE 0 END), 0) AS netprofitorloss,
    
    -- Profit payments
    COALESCE(SUM(CASE WHEN ps.Status = 'Payment' AND ps.Reasone = 'Daily Bank' THEN ps.Amount ELSE 0 END), 0) AS Profit_Payment,
     
    -- Rest amount calculation
    COALESCE(SUM(a.TotalBlance) - (SUM(a.DiscountTk) + SUM(sr.Amount)), 0) 
    + COALESCE(SUM(CASE WHEN ps.Reasone IN ('Others (Income)', 'Servicing Charge', 'Commission') THEN ps.Amount ELSE 0 END), 0) 
    - COALESCE((SELECT SUM(subquery.single_buy_cost) 
                FROM ( 
                    SELECT invaudit.qty, purchase.Rate, invaudit.qty * purchase.Rate AS single_buy_cost 
                    FROM invaudit 
                    INNER JOIN purchase ON invaudit.Barcode = purchase.Barcode
                ) AS subquery), 0) 
    - COALESCE(SUM(CASE WHEN ps.Reasone IN ('Monthly Bills', 'Entertainment', 'Carrying Charge', 'Other Expense', 'Yearly Bills', 'Commision', 'Discount', 'Purchasing Extra Expenditure', 'Daily Expenditure', 'Depreciation', 'Bank Interest', 'Salary') THEN ps.Amount ELSE 0 END), 0) 
    - COALESCE(SUM(CASE WHEN ps.Status = 'Payment' AND ps.Reasone = 'Daily Bank' THEN ps.Amount ELSE 0 END), 0) AS Rest_Amount

FROM 
    invaudit a

LEFT JOIN 
    (SELECT 
         sr.invoiceNo, 
         SUM(sr.Amount) AS Amount 
     FROM 
         sale_return sr 
     GROUP BY 
         sr.invoiceNo) sr ON a.invoiceNo = sr.invoiceNo
     
LEFT JOIN paymentstatement ps ON ps.Date BETWEEN '2024-01-01' AND CURRENT_DATE

WHERE 
    a.cdate BETWEEN 'Select date' AND 'To';  -- Replace 'Select date' and 'To' with actual date values
]]>
	</queryString>
